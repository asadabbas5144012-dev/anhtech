# ---------------------------------------------------------------
# Public (safe to expose to the browser)
# ---------------------------------------------------------------
# The canonical site URL, without a trailing slash. Leave empty until the
# domain is decided — while empty, the site tells search engines not to index it.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------
# Server-only (NEVER prefix these with NEXT_PUBLIC_)
# Contact form delivery via Resend (https://resend.com)
# ---------------------------------------------------------------
RESEND_API_KEY=
# Inbox that receives project inquiries
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "ANH Tech <noreply@yourdomain.com>"
CONTACT_FROM_EMAIL=
